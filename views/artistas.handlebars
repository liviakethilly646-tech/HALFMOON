<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/halfmoon@2.0.1/css/halfmoon.min.css" rel="stylesheet">
<href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="card">
<div id="meuAlerta"
     role="alert"
     style="display: none; background: #d1e7dd; color: #0f5132; padding: 12px; border-radius: 8px;">
  Cadastro realizado com sucesso!
</div>


<h1>Artistas</h1>
<a href="/artistas/cadastrar">Cadastrar novo artista</a>

<ul>
  {{#each artistas}}
    <li style="
        display: block;
        background: white;
        border: 2px solid #008080;
        padding: 15px;
        margin: 10px auto;
        border-radius: 15px;
        width: 300px;
        text-align: center;
        box-shadow: 0 6px 12px #ddd;
    ">
      <a href="/artistas/{{this.id}}">{{this.nome}}</a>
    </li>
  {{/each}}
</ul>
</div>

<div class="modoEscuro">
    <a href="/artistas2">Modo Escuro</a>
</div>

<div class="Voltar">
    <a href="/">Voltar</a>
</div> 
</div>

<style>
    .card {
    font-family: 'Nunito', sans-serif;
    background: linear-gradient(135deg, #008080, white, #008080);
    border: 2px solid #008080;
    border-radius: 20px;
    width: 500px;
    max-width: 90%;
    padding: 25px;
    margin: 70px auto 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
    box-sizing: border-box;
  }
  body{
    font-family: 'Nunito', sans-serif;
    background: linear-gradient(135deg, #008080, white, #008080);
  }

h1 {
    font-size: 36px;
    font-weight: 700;
}

p {
    font-size: 18px;
    color: #777;
}
 .alert-fade {
  transition: opacity 0.5s ease-out;
  opacity: 0;
  }

a {
    display: inline-block;
    background: white;
    color: #222;
    padding: 15px 25px;
    margin: 8px;
    border-radius: 15px;
    text-decoration: none;
    font-size: 16px;
    box-shadow: 0 2px 8px #ddd;
}

a:hover {
    background: #eee;
}
.modoEscuro {
    position: absolute;
    top: 20px;
    right: 20px;
}
.voltar {
    position: absolute;
    top: 20px;
    left: 20px;
  }
</style> 

<script>
  const alerta = document.getElementById('meuAlerta');
  const params = new URLSearchParams(window.location.search);

  if (params.get('cadastrado') === '1') {
    alerta.style.display = 'block';

    window.history.replaceState(
      {},
      document.title,
      window.location.pathname
    );

    setTimeout(() => {
      alerta.style.display = 'none';
    }, 3000);
  }
</script>

