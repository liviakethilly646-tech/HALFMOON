<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<div class="container">
<h1>Artistas</h1>

<a href="/artistas/cadastrar">Cadastrar novo artista</a>

<ul>
  {{#each artistas}}
    <li style="
        display: block;
        background: white;
        border: 2px solid #008080;
        padding: 15px;
        margin: 10px auto;
        border-radius: 15px;
        width: 300px;
        text-align: center;
        box-shadow: 0 6px 12px #ddd;
    ">
      <a href="/artistas/{{this.id}}">{{this.nome}}</a>
    </li>
  {{/each}}
</ul>
<div class="modoEscuro">
    <a href="/artistas2">Modo escuro</a>
</div>

<div class="Voltar">
    <a href="/">Voltar</a>
</div> 
</div>

<style>
    .container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    }
    body {
    font-family: 'Nunito', sans-serif;
    background: linear-gradient(135deg, #008080, #ffffff, #008080);
    color: #222;
    margin: 0;
    padding: 30px;
}

h1 {
    font-size: 36px;
    font-weight: 700;
}

p {
    font-size: 18px;
    color: #777;
}

a {
    display: inline-block;
    background: white;
    color: #222;
    padding: 15px 25px;
    margin: 8px;
    border-radius: 15px;
    text-decoration: none;
    font-size: 16px;
    box-shadow: 0 2px 8px #ddd;
}

a:hover {
    background: #eee;
}
.modoEscuro {
    position: absolute;
    top: 20px;
    right: 20px;
}
.voltar {
    position: absolute;
    top: 20px;
    left: 20px;
  }
.editar{
  color: #008080;
  text-decoration: none;
}
.editar:hover{
  color:#008080;
}
</style> 

