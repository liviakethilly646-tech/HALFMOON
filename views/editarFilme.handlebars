<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<link href="https://cdn.jsdelivr.net/npm/halfmoon@2.0.2/css/halfmoon.min.css" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<div class="card">

    <h1>Editar Filme</h1>

    <a href="/filmes">Voltar para Filmes</a>


    <form action="/filmes/{{filme.id}}?_method=PUT" method="POST">

        <label>Nome do Filme:</label>

        <input type="text" name="nome" value="{{filme.nome}}" required>

        <label>Ano:</label>

        <input type="number" name="ano" value="{{filme.ano}}" required>

        <button type="submit">

            Salvar Alterações

        </button>

    </form>



    <button type="button"
            class="btn btn-danger excluir"
            data-bs-toggle="modal"
            data-bs-target="#modal-excluir">

        <i class="fa-solid fa-trash-can"></i>

        Excluir Filme

    </button>

</div>


<div class="modal fade"
     id="modal-excluir"
     tabindex="-1"
     aria-labelledby="titulo-modal"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="titulo-modal">

                    Excluir filme

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">

                </button>

            </div>


            <div class="modal-body">

                <p>

                    Tem certeza que deseja excluir este filme?

                </p>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>


                <form action="/filmes/{{filme.id}}?_method=DELETE"
                      method="POST">

                    <button type="submit"
                            class="btn btn-danger">

                        Confirmar exclusão

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<div class="modoEscuro">
    <a href="/filmes2/{{filme.id}}/editar2">Modo escuro</a>
</div>

<div class="Voltar">
    <a href="/filmes">Voltar</a>
</div> 


<style>

    body {

        font-family: 'Nunito', sans-serif;

        background: linear-gradient(135deg, #008080, #ffffff, #008080);

        color: #222;

        margin: 0;

        padding: 30px;

    }


    .modoEscuro {

        position: absolute;

        top: 20px;

        right: 20px;

    }


    h1 {

        color: #222;

        text-align: center;

        font-size: 36px;

    }


    .card {

        display: flex;

        flex-direction: column;

        align-items: center;

    }


    .card {

        background: linear-gradient(

            135deg,

            #008080,

            #ffffff,

            #008080

        );

        padding: 25px;

        border: 2px solid #008080;

        border-radius: 15px;

        width: 300px;

        box-shadow: 0 6px 12px #ddd;

        margin: 30px auto;

    }


    .card h2 {

        text-align: center;

        color: #005555;

    }


    .card label {

        display: block;

        margin-top: 15px;

        font-weight: bold;

    }


    .card input,

    .card select {

        width: 100%;

        padding: 8px;

        margin-top: 5px;

        border: 1px solid #008080;

        border-radius: 5px;

        box-sizing: border-box;

    }


    .card button {

        width: 100%;

        margin-top: 20px;

        padding: 10px;

        background: #008080;

        color: white;

        border: none;

        border-radius: 5px;

        cursor: pointer;

    }


    .card button.excluir {

        background: #c0392b;

    }


    .card button.excluir:hover {

        background: #922b21;

    }


    a {

        display: inline-block;

        background: white;

        color: #222;

        padding: 12px 20px;

        margin: 8px;

        border-radius: 15px;

        text-decoration: none;

        box-shadow: 0 2px 8px #ddd;

    }


    .modoEscuro {

        position: absolute;

        top: 20px;

        right: 20px;

    }
    .voltar {
    position: absolute;
    top: 20px;
    left: 20px;
  }

</style>