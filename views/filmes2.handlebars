<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<div class="card">

  
  <div id="meuAlerta"
     role="alert"
     style="display: none; background: #d1e7dd; color: #0f5132; padding: 12px; border-radius: 8px;">
  Cadastro realizado com sucesso!
  </div>

<h1>Lista de Filmes</h1>

<a href="/filmes2/cadastrar2">
  Cadastrar Filme
</a>

<div class="modoClaro">
    <a href="/filmes">Modo Claro</a>
</div> 

<div class="Voltar">
    <a href="/halfmoon">Voltar</a>
</div> 

<ul>

  {{#each filmes}}

    <li style="
        display: block;
        background: white;
        border: 2px solid #008080;
        padding: 15px;
        margin: 10px auto;
        border-radius: 15px;
        width: 300px;
        text-align: center;
        box-shadow: 0 6px 12px #ddd;
        color: black;
    ">
      <div class="accordion">

            <details>
                <summary>{{this.nome}} - {{this.ano}}</summary>

                <div class="conteudo-filme">
                  <p><strong>Nome:</strong{{this.nome}}></p>

                  <p><strong>Ano:</strong> {{this.ano}}</p>

                  <p><strong>Diretor:</strong> {{this.diretor.nome}}</p>

                  <p><strong>Artistas:</strong>{{this.artistas.nome}}</p>

                    <ul>
                      {{#each this.artistas}}
                          <li>{{this.nome}}</li>
                      {{/each}}
                  </ul>
              </div>

            </details>

      </div>
      <br>
      <a href="/filmes2/{{this.id}}/editar2" class="editar">
        <i class="fa-solid fa-pen-to-square"></i>Editar
      </a>
    </li>

  {{/each}}

</ul>
</div>


<style>
    .card {
    font-family: 'Nunito', sans-serif;
    background:  linear-gradient(135deg, #000000, #008080, #000000);
    border: 2px solid white;
    border-radius: 20px;
    width: 500px;
    max-width: 90%;
    padding: 25px;
    margin: 70px auto 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
    box-sizing: border-box;
  }
  body{
    font-family: 'Nunito', sans-serif;
    background:  linear-gradient(135deg, #000000, #008080, #000000);
  }
  .alert-fade {
    transition: opacity 0.5s ease-out;
    opacity: 0;
    }

  h1 {
    color:white;
    font-size: 36px;
    font-weight: 700;
  }

  p {
    font-size: 18px;
    color: #000000;
  }

  a {
    display: inline-block;
    background: white;
    color: #000000;
    padding: 15px 25px;
    margin: 8px;
    border-radius: 15px;
    text-decoration: none;
    font-size: 16px;
    box-shadow: 0 2px 8px #ddd;
}

a:hover {
    background: #eee;
}
.modoClaro {
    position: absolute;
    top: 20px;
    right: 20px;
}
.voltar {
    position: absolute;
    top: 20px;
    left: 20px;
  }
    .accordion {
    width: 500px;
    max-width: 90%;
    margin: 30px auto;
}

.accordion details {
    background: white;
    border: 2px solid #008080;
    border-radius: 15px;
    margin: 15px 0;
    box-shadow: 0 4px 10px #ddd;
    overflow: hidden;
}

.accordion summary {
    padding: 20px;
    cursor: pointer;
    font-size: 20px;
    font-weight: bold;
    color: #222;
}

.accordion summary:hover {
    background: #eee;
}

.conteudo-filme {
    padding: 15px 20px;
    border-top: 1px solid #ddd;
    color: #222;
}

.conteudo-filme ul {
    padding-left: 25px;
}
.accordion p{
    display: inline-block;
    color: #000000;
    padding: 15px 25px;
    margin: 8px;
    text-decoration: none;
    font-size: 16px;
    box-shadow: 0 2px 8px #ddd;
}
.editar{
  color: #008080;
  text-decoration: none;
}
.editar:hover{
  color:#008080;
}
</style> 

<script>
  const alerta = document.getElementById('meuAlerta');
  const params = new URLSearchParams(window.location.search);

  if (params.get('cadastrado') === '1') {
    alerta.style.display = 'block';

    window.history.replaceState(
      {},
      document.title,
      window.location.pathname
    );

    setTimeout(() => {
      alerta.style.display = 'none';
    }, 3000);
  }
</script>
