<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<link href="https://cdn.jsdelivr.net/npm/halfmoon@2.0.1/css/halfmoon.min.css" rel="stylesheet">

<div class="card">

<h1>{{artista.nome}}</h1>
<h1>{{diretor.nome}}</h1>

<p>Ano de nascimento: {{diretor.anoNascimento}}</p>
<p>Nacionalidade: {{diretor.nacionalidade}}</p>
<label>Filmes dirigidos: {{diretor.filmesDirigidos}}</label>

<ul>
  {{#each diretor.filmes}}
    <li><a href="/diretores/{{this.id}}">{{this.nome}} ({{this.ano}})</a></li>
  {{/each}}
</ul>
</div>

<div class="modoEscuro">
    <a href="/diretores2/{{diretor.id}}">Modo Escuro</a>
</div>

<div class="Voltar">
    <a href="/diretores">Voltar</a>
</div> 

<style>
    .card {
    background: linear-gradient(135deg, #008080, white, #008080);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;

    width: 450px;
    max-width: 90%;
    min-height: 250px;
    padding: 25px;
    margin: 50px auto;

    border: 2px solid white;
    border-radius: 15px;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
    box-sizing: border-box;
}
    body {
    background: linear-gradient(135deg, #008080, white, #008080);
    color: white;
    margin: 0;
    padding: 30px;
  }

h1 {
  color: #222;
    font-size: 36px;
    font-weight: 700;
}

  p {
    color: #222;
    font-size: 18px;
  }
  label{
    color: #222;
  }

a {
    display: inline-block;
    background: white;
    color: #000000;
    padding: 15px 25px;
    margin: 8px;
    border-radius: 15px;
    text-decoration: none;
    font-size: 16px;
    box-shadow: 0 2px 8px #ddd;
}

a:hover {
    background: #eee;
}
.modoEscuro {
    position: absolute;
    top: 20px;
    right: 20px;
}
.voltar {
    position: absolute;
    top: 20px;
    left: 20px;
  }
</style> 
