
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="card">

    <h1>Editar Filme</h1>

    <a href="/filmes2">Voltar para Filmes</a>

    <form action="/filmes2/{{filme.id}}?_method=PUT" method="POST">

        <label>Nome do Filme:</label>
        <input type="text" name="nome" value="{{filme.nome}}" required>

        <label>Ano:</label>
        <input type="number" name="ano" value="{{filme.ano}}" required>

        <button type="submit">
            Salvar Alterações
        </button>

    </form>

    <form action="/filmes2/{{filme.id}}?_method=DELETE" method="POST">
        <button class="btn btn-danger excluir">
            <i class="fa-solid fa-trash-can"></i>
            Excluir Filme
        </button>
    </form>

</div>

<div class="modoClaro">
    <a href="/filmes/{{filme.id}}/editar">Modo Claro</a>
</div> 

<div class="Voltar">
    <a href="/filmes2">Voltar</a>
</div> 

