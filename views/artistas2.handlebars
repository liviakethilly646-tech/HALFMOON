<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<div class="container">

<h1>Artistas</h1>

<a href="/artistas2/cadastrar2">Cadastrar novo artista</a>

<ul>
  {{#each artistas}}
    <li style="
        display: block;
        background: white;
        border: 2px solid #008080;
        padding: 15px;
        margin: 10px auto;
        border-radius: 15px;
        width: 300px;
        text-align: center;
        box-shadow: 0 6px 12px #ddd;
    ">
      <a href="/artistas2/{{this.id}}">{{this.nome}}</a>
    </li>
  {{/each}}
</ul>
</div>
<div class="modoClaro">
    <a href="/artistas">Modo Claro</a>
</div> 
<div class="Voltar">
    <a href="/halfmoon">Voltar</a>
</div> 


